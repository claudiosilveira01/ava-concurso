# ─── Biblioteca local de PDFs ────────────────────────────────────────
# Pasta raiz que contém uma subpasta por disciplina (PORTUGUES, LEGISLACAO, ...).
# Se não definir, usa o caminho padrão já configurado em lib/localLibrary.ts.
POTENCIAL_CONCURSOS_PATH=C:\Users\webap\Documents\POTENCIAL CONCURSOS

# ─── Firebase (client) ───────────────────────────────────────────────
# Opcional: sem essas variáveis o app grava tudo em .data/db.json (arquivo local).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server) ─────────────────────────────────────────
# Cole aqui o JSON da service account inteiro em uma linha só
FIREBASE_ADMIN_SDK_KEY=

# ─── Versão online (Supabase + senha de acesso) ──────────────────────
# Sem essas variáveis o AVA continua funcionando 100% local, como antes.
# SUPABASE_URL: endereço do projeto (https://<id>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: chave SECRETA do projeto. Nunca commitar, nunca expor no navegador.
# AVA_SENHA: senha única para entrar no AVA online. Se vazia, o acesso fica aberto (uso local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AVA_SENHA=
